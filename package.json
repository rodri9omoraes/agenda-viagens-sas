{
  "name": "agenda-viagens-sas",
  "version": "1.0.1",
  "description": "Sistema de Agenda de Viagens - Secretaria de Assistência Social",
  "main": "main.js",
  "icon": "assets/ICON_SAS.ico",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch . --exec electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.sas.agendaviagens",
    "productName": "Agenda Viagens SAS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": ["agenda", "viagens", "assistencia-social"],
  "author": "Secretaria de Assistência Social",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.0.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.9.0",
    "html2canvas": "^1.4.1",
    "cors": "^2.8.5"
  }
}